---
// The windrose compass mark — cardinal points in solid pine,
// intercardinal points in clay. Colored via currentColor + accent.
const { class: className = '' } = Astro.props;
---
<svg class={`windrose ${className}`} viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none">
  <circle cx="50" cy="50" r="48" stroke="currentColor" stroke-width="1" opacity="0.35" />
  <circle cx="50" cy="50" r="41" stroke="currentColor" stroke-width="0.5" opacity="0.25" />
  <g fill="currentColor">
    <path d="M50 3 L54 50 L50 50 Z" />
    <path d="M50 3 L46 50 L50 50 Z" opacity="0.45" />
    <path d="M97 50 L50 54 L50 50 Z" />
    <path d="M97 50 L50 46 L50 50 Z" opacity="0.45" />
    <path d="M50 97 L46 50 L50 50 Z" />
    <path d="M50 97 L54 50 L50 50 Z" opacity="0.45" />
    <path d="M3 50 L50 46 L50 50 Z" />
    <path d="M3 50 L50 54 L50 50 Z" opacity="0.45" />
  </g>
  <g fill="currentColor" opacity="0.55" transform="rotate(45 50 50)">
    <path d="M50 20 L53 50 L47 50 Z" />
    <path d="M80 50 L50 53 L50 47 Z" />
    <path d="M50 80 L47 50 L53 50 Z" />
    <path d="M20 50 L50 47 L50 53 Z" />
  </g>
  <circle cx="50" cy="50" r="3.5" fill="currentColor" />
</svg>
