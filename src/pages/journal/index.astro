---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('journal')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base
  title="Journal | Windrose Farm"
  description="Dated notes from Windrose Farm, a homestead being built on hard ground in Arizona's high desert."
>
  <div class="wrap page-head">
    <h1>Journal</h1>
    <p>
      Dated notes, written when something happens. To follow along, use the
      <a href="/rss.xml">RSS feed</a> or write to
      <a href="mailto:hello@windrose.farm">hello@windrose.farm</a>.
    </p>
  </div>

  <section>
    <div class="wrap">
      <ul class="entry-list">
        {entries.map((e) => (
          <li>
            <time datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
            <h3><a href={`/journal/${e.id}/`}>{e.data.title}</a></h3>
            <p>{e.data.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
