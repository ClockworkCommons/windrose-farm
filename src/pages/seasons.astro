---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';

import sunsetTurbines from '../assets/photos/sunset-turbines.jpg';
import barnSunset from '../assets/photos/barn-sunset.jpg';
import sunsetWindow from '../assets/photos/sunset-window.jpg';
import goldenClouds from '../assets/photos/golden-clouds.jpg';
import milkyWay from '../assets/photos/milky-way.jpg';
import snowGutter from '../assets/photos/snow-gutter.jpg';
import wildflowers from '../assets/photos/wildflowers-yellow.jpg';
import paintbrush from '../assets/photos/paintbrush.jpg';
import primrose from '../assets/photos/primrose.jpg';
import tracks from '../assets/photos/animal-tracks.jpg';
import campfire from '../assets/photos/campfire.jpg';

const three = '(max-width: 44rem) 100vw, 24rem';
const two = '(max-width: 44rem) 100vw, 36rem';
---
<Base
  title="The Seasons: a year on the land | Windrose Farm"
  description="Photos of what 37 acres of Arizona high desert does on its own through the year: spring wildflowers, sunsets, snow, and a dark night sky."
  image={barnSunset}
>
  <div class="wrap page-head">
    <h1>A year on the land</h1>
    <p>
      Before anything is planted, the first job is to pay attention. These
      are photos of what the land does without us, in the order the year
      brings it.
    </p>
  </div>

  <section>
    <div class="wrap prose">
      <p class="eyebrow">Spring</p>
      <h2>Wildflowers</h2>
      <p>
        Nobody planted, watered or tended these. All three were photographed
        in May 2026.
      </p>
      <div class="photo-row cols-3">
        <Photo src={wildflowers} sizes={three} alt="Yellow wildflowers blooming low against red gravelly soil">
          Yellow wildflowers coming up through gravel.
        </Photo>
        <Photo src={paintbrush} sizes={three} alt="Red Indian paintbrush flowering among dry grass on red soil">
          Indian paintbrush.
        </Photo>
        <Photo src={primrose} sizes={three} alt="White evening primrose flowers open against rocky red ground">
          Evening primrose.
        </Photo>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap prose">
      <p class="eyebrow">Summer and fall</p>
      <h2>Evening skies</h2>
      <p>
        The turbines on the horizon run on the same prevailing wind the farm
        is named for.
      </p>
      <div class="photo-row cols-2">
        <Photo src={sunsetTurbines} sizes={two} alt="Rows of wind turbines on the horizon against a deep orange sunset">
          Wind turbines at sunset, August 2026.
        </Photo>
        <Photo src={barnSunset} sizes={two} alt="The barn in silhouette against an orange and pink sunset">
          The barn at sunset, October 2026.
        </Photo>
        <Photo src={sunsetWindow} sizes={two} alt="A sunset reflected in a window set in the barn's red metal siding">
          The same evening, reflected in a barn window.
        </Photo>
        <Photo src={goldenClouds} sizes={two} alt="Low sun lighting a bank of clouds gold above the horizon">
          Evening clouds, October 2026.
        </Photo>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap prose">
      <p class="eyebrow">Winter</p>
      <h2>Snow</h2>
      <Photo class="inline" src={snowGutter} alt="Snow lying along the barn's gutter and roof edge, with a chewed cable hanging below it">
        Snow along the barn gutter. The chewed cable is a camera cord,
        courtesy of the neighboring ranch's cattle.
      </Photo>
    </div>
  </section>

  <section>
    <div class="wrap prose">
      <p class="eyebrow">After dark</p>
      <h2>Camp and the night sky</h2>
      <p>
        Nobody lives here yet, so for now we camp. The property is far
        enough from town lights that the Milky Way shows on a clear night.
      </p>
      <div class="photo-row cols-3">
        <Photo src={campfire} sizes={three} alt="A fire in a steel fire pit at dusk beside a camper">
          Camp beside the barn, October 2026.
        </Photo>
        <Photo src={tracks} sizes={three} alt="Paw prints in soft dirt beside a boot for scale">
          Tracks on the drive, October 2026. Boot for scale.
        </Photo>
        <Photo src={milkyWay} sizes={three} alt="The Milky Way across a dense field of stars">
          The Milky Way from the property, October 2026. Phone camera, night mode.
        </Photo>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap prose">
      <p>More photos will be added as the years go by.</p>
    </div>
  </section>

  <section class="next-step">
    <div class="wrap">
      <a class="btn" href="/journal/">Keep up to date in the journal →</a>
    </div>
  </section>
</Base>
