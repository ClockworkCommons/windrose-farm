---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import barnPhoto from '../assets/photos/barn-and-turbines.webp';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
}

const {
  title,
  description = 'A family homestead on 37 acres of high desert in northeastern Arizona: shallow soil, about twelve inches of rain, and a long plan to grow food on it anyway.',
  image = barnPhoto,
} = Astro.props;

// Preview image shown when a link to the site is shared.
const card = await getImage({ src: image, width: 1200, height: 630, format: 'jpg' });
const cardUrl = new URL(card.src, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Windrose Farm Journal" href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Windrose Farm" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={cardUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
