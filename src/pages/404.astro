---
import Base from '../layouts/Base.astro';
import Windrose from '../components/Windrose.astro';
---
<Base title="Lost your bearings — Windrose Farm">
  <section class="hero wrap">
    <Windrose />
    <h1>Lost your bearings?</h1>
    <p class="lede">
      This page doesn't exist — or hasn't been built yet. On a farm measured
      in decades, that happens. Let the windrose point you home.
    </p>
    <div class="cta-row">
      <a class="btn btn-solid" href="/">Back to the farm</a>
    </div>
  </section>
</Base>
