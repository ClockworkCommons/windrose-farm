---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Windrose from '../components/Windrose.astro';
import barnPhoto from '../assets/photos/barn-and-turbines.webp';
import sunsetTurbines from '../assets/photos/sunset-turbines.jpg';

const entries = (await getCollection('journal'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Windrose Farm: a homestead in Arizona's high desert">
  <section class="hero">
    <div class="hero-photo">
      <Image
        src={barnPhoto}
        alt="A red barn on open grassland under a wide blue sky, with wind turbines on the horizon behind it"
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
        loading="eager"
      />
    </div>
    <div class="wrap hero-text">
      <div class="hero-copy">
        <h1>Windrose Farm</h1>
        <p class="lede">
          Thirty-seven acres of high desert in northeastern Arizona, at about
          5,700 feet. We closed on the property at the very end of 2025.
          Nothing is planted yet. This site is the record of what we try.
        </p>
        <p class="hero-links">
          <a class="btn" href="/story/">Start with our story</a>
          <a href="/journal/">or read the journal</a>
        </p>
      </div>
      <Windrose class="hero-mark" />
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Where things stand</h2>
      <p class="note">As of November 2026.</p>
      <dl class="status">
        <dt>Done</dt>
        <dd>General cleanup, and the well plumbing has been reworked.</dd>
        <dt>Next</dt>
        <dd>A lab soil test, the first swales, a first hügelkultur mound, and fencing for the first growing area.</dd>
        <dt>Not started</dt>
        <dd>The orchard, the gardens, the bees and the vineyard. All four are still plans.</dd>
        <dt>Gone wrong</dt>
        <dd>Time. We don't have enough of it.</dd>
      </dl>
      <p class="measure">
        The ground is the hard part: bedrock 8 to 20 inches down, alkaline
        soil, and about twelve inches of rain a year.
        <a href="/land/">The Land</a> is the page with the uncomfortable
        numbers on it. <a href="/farm/">The Farm</a> covers what we plan to
        grow.
      </p>
    </div>
  </section>

  <figure class="photo-band">
    <Image
      src={sunsetTurbines}
      alt="Wind turbines in a long row on the horizon against an orange sunset"
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      loading="lazy"
    />
    <figcaption>
      Sunset over the turbines, August 2026. There are more photos of the
      year on <a href="/seasons/">The Seasons</a>.
    </figcaption>
  </figure>

  <section>
    <div class="wrap">
      <h2>From the journal</h2>
      <ul class="entry-list">
        {entries.map((e) => (
          <li>
            <time datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
            <h3><a href={`/journal/${e.id}/`}>{e.data.title}</a></h3>
            <p>{e.data.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
